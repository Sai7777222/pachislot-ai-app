# Paths (D:\AI 配下)
MODELS_DIR=D:\AI\models
DATA_DIR=D:\AI\data
CACHE_DIR=D:\AI\cache
HF_HOME=D:\AI\cache\huggingface

# Phase 2: 構造化DB / RAGストア (別ファイルに分離)
STRUCTURED_DB_PATH=D:\AI\data\processed\db\structured.db
RAG_DB_PATH=D:\AI\data\processed\db\rag_store.db

# Phase 3: RAG (Embedding / Vector DB)
EMBEDDING_MODEL_PATH=D:\AI\models\embedding\multilingual-e5-base
EMBEDDING_DEVICE=cpu
VECTOR_DB_PATH=D:\AI\cache\vector_db
VECTOR_DB_COLLECTION=pachislot_rag
RAG_TOP_K=6
RAG_CHUNK_MAX_CHARS=500

# LLM (Phase 0/1: llama-cpp-python + GGUF)
LLM_PROVIDER=local_llama_cpp
LLM_MODEL_PATH=D:\AI\models\llm\qwen2.5-14b-instruct-q4_k_m-00001-of-00003.gguf
LLM_N_GPU_LAYERS=-1
LLM_CONTEXT_SIZE=8192
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# API (Phase 1)
API_HOST=0.0.0.0
API_PORT=8000

# Phase 4E: リル QLoRA学習のSlack通知 (Incoming Webhook)
# training/riru/train_qlora.py の本学習(--i-confirm-start-training)完了/失敗時のみ通知する。
# ここには実際のURLを書かないこと。実URLは各自のローカル .env にのみ設定する。
# 未設定の場合は通知がスキップされるだけで、学習自体には影響しない。
SLACK_WEBHOOK_URL=
