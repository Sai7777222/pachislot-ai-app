{
  "_comment": "Phase 4C: リル人格QLoRA 第一候補設定。旧calm2環境の設定(15epoch等)は流用していない。RTX 5090 32GB向け初回試験用。",

  "base_model": {
    "hf_repo_id": "Qwen/Qwen2.5-14B-Instruct",
    "local_path": "D:/AI/models/llm-hf/Qwen2.5-14B-Instruct",
    "note": "GGUF (D:/AI/models/llm/qwen2.5-14b-instruct-q4_k_m-*.gguf) は推論専用。学習にはHF形式が別途必要 (2026-08-24時点で未取得)。"
  },

  "quantization": {
    "load_in_4bit": true,
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_compute_dtype": "bfloat16",
    "bnb_4bit_use_double_quant": true
  },

  "lora": {
    "r": 16,
    "lora_alpha": 16,
    "lora_alpha_alt_candidate": 32,
    "lora_dropout": 0.08,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "mlp_modules_note": "gate_proj/up_proj/down_proj は初回試験では追加しない (ユーザー指示どおり)",
    "bias": "none",
    "task_type": "CAUSAL_LM"
  },

  "training": {
    "num_train_epochs": 3,
    "learning_rate": 1e-4,
    "optim": "paged_adamw_8bit",
    "max_seq_length": 2048,
    "gradient_checkpointing": true,
    "bf16": true,
    "fp16": false,
    "warmup_ratio": 0.05,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "seed": 42,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "_resolved_micro_batch_size": 2,
    "_resolved_grad_accum": 8,
    "per_device_eval_batch_size": 2,
    "eval_strategy": "steps",
    "eval_steps": 20,
    "save_strategy": "steps",
    "save_steps": 20,
    "save_total_limit": 3,
    "logging_steps": 5,
    "load_best_model_at_end": true,
    "metric_for_best_model": "eval_loss"
  },

  "loss": {
    "mode": "assistant_only",
    "description": "system/userトークンはlabel=-100でマスクし、assistantターンのみlossに寄与させる。tokenizer.apply_chat_template()の増分差分でassistant区間を特定する。"
  },

  "data": {
    "train_path": "training/riru/processed/riru_train_v1.jsonl",
    "val_path": "training/riru/processed/riru_val_v1.jsonl",
    "format": "messages (role/content) + metadata。system promptは学習データ本文に含めない。"
  },

  "output": {
    "adapter_dir": "training/riru/lora-riru-qwen-v1",
    "checkpoint_dir": "training/riru/lora-riru-qwen-v1/checkpoints",
    "log_dir": "training/riru/lora-riru-qwen-v1/logs"
  }
}
